{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/SonghaiFan/narrative-graph/main/schema/story.schema.json",
  "title": "Generated story",
  "description": "What the writer in python/narrative_deducer.py produces: one chapter per node of the narrative structure. It matches the Story and Chapter models in python/meta/types.py. Story files written by older versions of the code use the fields event and topics instead of title and Topic and do not match.",
  "type": "object",
  "required": ["chapters"],
  "additionalProperties": false,
  "properties": {
    "chapters": {
      "type": "array",
      "items": { "$ref": "#/$defs/chapter" }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "chapter": {
      "type": "object",
      "required": ["id", "title", "time_period", "Topic", "entity", "content"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "The node id in the narrative structure, for example A1: a theme letter and the chapter number.",
          "type": "string",
          "minLength": 1
        },
        "title": { "type": "string" },
        "time_period": {
          "description": "Start and end date, YYYY-MM-DD.",
          "type": "array",
          "items": { "$ref": "#/$defs/date" },
          "minItems": 2,
          "maxItems": 2
        },
        "Topic": {
          "description": "Themes of the chapter. The capital T is how the models spell it.",
          "type": "array",
          "items": { "type": "string" }
        },
        "entity": { "type": "array", "items": { "type": "string" } },
        "content": {
          "description": "The chapter text, about 100 words.",
          "type": "string"
        }
      }
    }
  }
}
